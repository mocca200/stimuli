{
  "$schema": "mvt.theme/1",
  "tokens": {
    "color.bg": "#0B0D10",
    "color.surface": "#141A24",
    "color.surfaceRaised": "#1B2230",
    "color.border": "#283244",
    "color.text": "#E8EEF7",
    "color.textMuted": "#7A879B",
    "color.accent": "#5EE7FF",
    "color.accentWarm": "#FFB86B",
    "color.harmonic": "#7EA6FF",
    "color.percussive": "#FF7A90",

    "space.xs": "4px",
    "space.sm": "8px",
    "space.md": "12px",
    "space.lg": "20px",
    "space.xl": "32px",

    "radius.sm": "6px",
    "radius.md": "10px",
    "radius.lg": "16px",

    "type.display": { "family": "Inter", "size": "28px", "weight": 700, "lineHeight": 34 },
    "type.title": { "family": "Inter", "size": "18px", "weight": 600, "lineHeight": 24 },
    "type.body": { "family": "Inter", "size": "14px", "weight": 400, "lineHeight": 20 },
    "type.mono": { "family": "JetBrains Mono", "size": "12px", "weight": 400, "lineHeight": 16 },

    "shadow.panel": { "x": 0, "y": 6, "blur": 18, "color": "#00000066" }
  },
  "variants": {
    "highContrast": {
      "color.bg": "#000000",
      "color.surface": "#0A0A0A",
      "color.surfaceRaised": "#141414",
      "color.border": "#5A5A5A",
      "color.text": "#FFFFFF",
      "color.textMuted": "#C8C8C8",
      "color.accent": "#00FFFF"
    },
    "reducedMotion": {
      "motion.enabled": false
    }
  }
}
