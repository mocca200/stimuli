{
  "$schema": "mvt.layout/1",
  "root": {
    "id": "root",
    "type": "container",
    "style": {
      "direction": "column",
      "padding": "$space.lg",
      "gap": "$space.md",
      "background": "$color.bg"
    },
    "children": [
      {
        "id": "header",
        "type": "container",
        "style": { "direction": "row", "height": 56, "alignItems": "center", "gap": "$space.md" },
        "children": [
          { "id": "title", "type": "label", "style": { "flex": 1, "height": 32 }, "text": "Stimuli" },
          { "id": "quality", "type": "label", "style": { "width": 120, "height": 28 }, "text": "Standard" }
        ]
      },
      {
        "id": "spectrum",
        "type": "spectrogram",
        "style": { "flex": 1, "minHeight": 180 }
      },
      {
        "id": "lower",
        "type": "container",
        "style": { "direction": "row", "height": 180, "gap": "$space.md" },
        "children": [
          { "id": "scope", "type": "vectorscope", "style": { "flex": 1 } },
          { "id": "wave", "type": "waveform", "style": { "flex": 1 } },
          { "id": "meters", "type": "spectrum", "style": { "flex": 1 } }
        ]
      }
    ]
  }
}
